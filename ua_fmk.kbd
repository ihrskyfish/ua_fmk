;; ============================================================
;; 别名定义：每个按键对应一个别名
;; ============================================================
(defalias
  q (chord chording q)
  w (chord chording w)
  e (chord chording e)
  r (chord chording r)
  t (chord chording t)
  y (chord chording y)
  u (chord chording u)
  i (chord chording i)
  o (chord chording o)
  p (chord chording p)
  a (chord chording a)
  s (chord chording s)
  d (chord chording d)
  f (chord chording f)
  g (chord chording g)
  h (chord chording h)
  j (chord chording j)
  k (chord chording k)
  l (chord chording l)
  ; (chord chording ;)
  z (chord chording z)
  x (chord chording x)
  c (chord chording c)
  v (chord chording v)
  b (chord chording b)
  n (chord chording n)
  m (chord chording m)
  , (chord chording ,)
  . (chord chording .)
  / (chord chording /)
)

;; ============================================================
;; 基础层：引用别名
;; ============================================================
;; (deflayer base
;;   @q  @w  @e  @r  @t  @y  @u  @i  @o  @p
;;   @a  @s  @d  @f  @g  @h  @j  @k  @l  @;
;;   @z  @x  @c  @v  @b  @n  @m  @,  @.  @/
  
;; )




;; ========== 基础层：正常打字 ==========
(deflayer base
  q w e r t   y u i o p
  a s d f g   h j k l ;
  z x c v b   n m , . /
  @dual
  )


;; ========== 并击层：按住 Space 激活 ==========
(deflayer dual
  @q @w @e @r @t   @y @u @i @o @p
  @a @s @d @f @g   @h @j @k @l @;
  @z @x @c @v @b   @n @m @, @. @/
  _
)
