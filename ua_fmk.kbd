;; -*- mode: lisp; eval: (local-set-key (kbd "C-c <f5>")  (lambda () (interactive) (execute-kbd-macro (kbd "C-x C-s <escape> & <down> k a n a t a <tab> - - d e b u g SPC - - c f g SPC <return>")) ) ) -*-


;; 速录宝小写键盘 Kanata 配置
;; 并击组：所有组合键放在一个 chords 组里

(defcfg
  process-unmapped-keys no
)

(defsrc
  q w e r t y u i o p
  a s d f g h j k l ;
  z x c v b n m , . /
 spc  
)

(defalias
  dual (tap-hold 200 200 spc (layer-while-held dual))
  )

;; ============================================================
;; 并击组：所有组合键放在同一个 chords 组里
;; ============================================================
(defchords chording 200
;;group-A
  ;; 第一行输出
  (q) q
  (w) w
  (e) e
  (r) r
  (t) t
  (e f) y      ;; 左手 e+f 同时按 → y
  (e r) u      ;; 左手 e+r 同时按 → u
  (w e) i      ;; 左手 w+e 同时按 → i
  (w r) o      ;; 左手 w+r 同时按 → o
  (q r) p      ;; 左手 q+r 同时按 → p

  ;; 第二行输出
  (a) a
  (s) s
  (d) d
  (f) f
  (g) g
  (w f) h      ;; 左手 w+f 同时按 → h
  (d f) j      ;; 左手 d+f 同时按 → j
  (s d) k      ;; 左手 s+d 同时按 → k
  (s f) l      ;; 左手 s+f 同时按 → l
  (a f) ;      ;; 左手 a+f 同时按 → ;

  ;; 第三行输出
  (z) z
  (x) x
  (c) c
  (v) v
  (b) b
  (s c) n      ;; 左手 s+c 同时按 → n
  (c v) m      ;; 左手 c+v 同时按 → m
  (x c) ,      ;; 左手 x+c 同时按 → ,
  (x v) .      ;; 左手 x+v 同时按 → .
  (z v) /      ;; 左手 z+v 同时按 → /


;;group-B
  (p) q       ;; 右手 p → q（第二组）
  (o) w       ;; 右手 o → w
  (i) e       ;; 右手 i → e
  (u) r       ;; 右手 u → r
  (y) t       ;; 右手 y → t
  (j i) y      ;; 右手 j+i 同时按 → y（带点）
  (u i) u      ;; 右手 u+i 同时按 → u（带点）
  (i o) i      ;; 右手 i+o 同时按 → i（带点）
  (u o) o      ;; 右手 u+o 同时按 → o（带点）
  (p u) p      ;; 右手 p+u 同时按 → p（带点）


  (;) a       ;; 右手 ; → a（第二组）
  (l) s       ;; 右手 l → s
  (k) d       ;; 右手 k → d
  (j) f       ;; 右手 j → f
  (h) g       ;; 右手 h → g
  (j o) h      ;; 右手 j+o 同时按 → h（带点）
  (j k) j      ;; 右手 j+k 同时按 → j（带点）
  (k l) k      ;; 右手 k+l 同时按 → k（带点）
  (j l) l      ;; 右手 j+l 同时按 → l（带点）
  (j ;) ;      ;; 右手 j+; 同时按 → ;（带点）


  (/) z       ;; 右手 / → z（第二组）
  (.) x       ;; 右手 . → x
  (,) c       ;; 右手 , → c
  (m) v       ;; 右手 m → v
  (n) b       ;; 右手 n → b
  (, l) n      ;; 右手 m+l 同时按 → n（带点）
  (m ,) m      ;; 右手 m+, 同时按 → m（带点）
  (, .) ,      ;; 右手 ,+. 同时按 → ,（带点）
  (m .) .      ;; 右手 m+. 同时按 → .（带点）
  (m /) /      ;; 右手 m+/ 同时按 → /（带点）


;;group-A&B
;; ===== 左右手同时：对应位置组合 =====
  ;; 第一行对应：q+p, w+o, e+i, r+u, t+y
  (q p) (macro q q spc)
  (w o) (macro w w spc)
  (e i) (macro e e spc)
  (r u) (macro r r spc)
  (t y) (macro t t spc)

  ;; 第二行对应：a+;, s+l, d+k, f+j, g+h
  (a ;) (macro a a spc)
  (s l) (macro s s spc)
  (d k) (macro d d spc)
  (f j) (macro f f spc)
  (g h) (macro g g spc)

  ;; 第三行对应：z+/, x+., c+,, v+m, b+n
  (z /) (macro z z spc)
  (x .) (macro x x spc)
  (c ,) (macro c c spc)
  (v m) (macro v v spc)
  (b n) (macro b b spc)

  ;; 左右对应组合同时按 → 输出两次
  (e f j i) (macro y y spc)
  (e r u i) (macro u u spc)
  (w e i o) (macro i i spc)
  (w r u o) (macro o o spc)
  (q r p u) (macro p p spc)
  (w f j o) (macro h h spc)
  (d f j k) (macro j j spc)
  (s d k l) (macro k k spc)
  (s f j l) (macro l l spc)
  (a f j ;) (macro ; ; spc)
  (s c ,  l) (macro n n spc)
  (c v m ,) (macro m m spc)
  (x c , .) (macro , , spc)
  (x v m .) (macro . . spc)
  (z v m /) (macro / / spc)



  ;; ======================

